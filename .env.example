# Server Environment Configuration (.env.example)

NODE_ENV=development
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Discord
DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_guild_id
ALLOWED_USER_IDS=user_id_1,user_id_2

# Google Drive (Owner OAuth Refresh Token)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
DRIVE_WEBHOOK_TOKEN=generate_a_random_secure_token

# Supabase (Service Role Key server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Cron
CRON_SECRET=generate_a_random_cron_secret

# Tuning & Modes
DEBOUNCE_SECONDS=0
POLLING_ONLY=false
